# ------------------------------------------------------------------
# FOMO Firewall - environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Market data mode: "mock" (stable demo data) or "live" (real Binance data)
DATA_MODE=mock

# Safety switch. When true, order execution is ALWAYS simulated.
# Set to "false" ONLY with an authenticated Binance MCP session.
DRY_RUN=true

# Hard capital cap per trade, in USDT. The agent will refuse any
# trade plan above this amount.
MAX_TRADE_USDT=50

# Binance MCP (Agent OS) endpoint.
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic

# OAuth access token for Binance MCP. Obtain it by completing the
# Binance OAuth flow manually (see README -> "Binance MCP Integration").
# Keep this server-side only. Never expose it to the browser.
BINANCE_MCP_TOKEN=

# How long to wait for the MCP endpoint before falling back to REST
# market data (milliseconds). Lower = snappier fallback on restricted networks.
BINANCE_MCP_CONNECT_TIMEOUT_MS=5000

# Optional: override the public REST endpoint used for live market data.
# If api.binance.com is unreachable on your network, Binance's official
# public market-data mirror works identically:
#   BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_REST_URL=https://api.binance.com
